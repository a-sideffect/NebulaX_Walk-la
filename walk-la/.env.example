# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.
# IMPORTANT: never put real credentials in THIS file either -- it's the template that gets committed.

# OneMap (SLA) account -- register at https://www.onemap.gov.sg/apidocs/register
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# LTA DataMall -- register at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=

# data.gov.sg real-time weather API
DATAGOV_API_KEY=

# Port for the local server (npm run server). Cloud Run overrides this
# automatically via its own PORT env var -- no need to set it there.
PORT=3001
